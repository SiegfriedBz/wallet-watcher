{
	"name": "wallet-watcher",
	"version": "1.0.0",
	"description": "Custody-style backend: HD wallets, balance tracking with a ledger, and signed ETH withdrawals on Sepolia",
	"private": true,
	"engines": {
		"node": ">=22.13"
	},
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"generate:mnemonic": "tsx scripts/generate-mnemonic.ts"
	},
	"keywords": [],
	"author": "Siegfried Bozza (https://github.com/SiegfriedBz)",
	"packageManager": "pnpm@10.24.0",
	"dependencies": {
		"@hono/node-server": "^2.1.3",
		"@scure/bip39": "^2.4.0",
		"hono": "^4.13.12",
		"viem": "^2.57.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^24.19.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
